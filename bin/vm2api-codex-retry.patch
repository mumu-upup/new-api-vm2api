@@ -3,6 +3,7 @@ import assert from 'node:assert/strict'
 import fs from 'node:fs'
 import os from 'node:os'
 import path from 'node:path'
+import { EventEmitter } from 'node:events'
 import {
   isRetryableCodexTransport,
   runCodexKernelHop,
@@ -71,6 +72,20 @@ test('runCodexKernelHop does not retry after SSE has started', async () => {
   assert.equal(result.transport_retried, undefined)
 })
 
+test('runCodexKernelHop rechecks cancellation after retry admission resolves', async () => {
+  const controller = new AbortController()
+  let calls = 0
+  await runCodexKernelHop({
+    args: { signal: controller.signal },
+    hop: async () => {
+      calls += 1
+      queueMicrotask(() => queueMicrotask(() => controller.abort()))
+      return { ok: false, status: 502, committed: false, body: { error: { code: 'upstream_transport' } } }
+    },
+  })
+  assert.equal(calls, 1)
+})
+
 function writeGptVm(root, id) {
   const dir = path.join(root, 'vms')
   fs.mkdirSync(path.join(dir, id), { recursive: true })
@@ -858,6 +873,237 @@ test('transient GPT failures retry the same account three times before switching
   fs.rmSync(root, { recursive: true, force: true })
 })
 
+for (const scenario of [
+  { name: '500 overload', statuses: [500], codes: ['server_is_overloaded'], calls: 2, status: 200 },
+  { name: '503 overload', statuses: [503], codes: ['server_is_overloaded'], calls: 2, status: 200 },
+  {
+    name: 'transient then transport',
+    statuses: [503, 502],
+    codes: ['server_error', 'upstream_transport'],
+    calls: 2,
+    status: 502,
+  },
+  {
+    name: 'transport budget',
+    statuses: [502, 502],
+    codes: ['upstream_transport', 'upstream_transport'],
+    calls: 2,
+    status: 502,
+  },
+  { name: 'one total attempt', statuses: [502], codes: ['upstream_transport'], total: 1, calls: 1, status: 502 },
+  { name: 'retries disabled', statuses: [502], codes: ['upstream_transport'], retries: 0, calls: 1, status: 502 },
+  {
+    name: 'committed overload',
+    statuses: [503],
+    codes: ['server_is_overloaded'],
+    committed: true,
+    calls: 1,
+    status: 503,
+  },
+]) {
+  test(`Codex bounded retries preserve the request and count every call: ${scenario.name}`, async (t) => {
+    const root = fs.mkdtempSync(path.join(os.tmpdir(), 'kin-codex-bounded-'))
+    t.after(() => fs.rmSync(root, { recursive: true, force: true }))
+    writeGptVm(root, 'vm-gpt-a')
+    const calls = []
+    const logBag = {}
+    const args = codexArgs(
+      root,
+      {
+        ensureCodexKernel: async () => ({ ok: true }),
+        streamCodexKernel: async (call) => {
+          calls.push({ vm: call.exec.vmId, body: structuredClone(call.body), envelope: structuredClone(call.envelope) })
+          const index = calls.length - 1
+          if (scenario.statuses[index])
+            return {
+              ok: false,
+              status: scenario.statuses[index],
+              committed: scenario.committed === true,
+              body: { error: { code: scenario.codes[index], message: 'busy' } },
+            }
+          return { ok: true, status: 200, terminalState: 'verified' }
+        },
+      },
+      {
+        logBag,
+        body: { model: 'gpt-5.5', input: 'Keep this exact text', reasoning: { effort: 'high' }, stream: false },
+        routing: {
+          failover: {
+            max_total_attempts: scenario.total ?? 2,
+            max_account_switches: 0,
+            max_same_account_retries: scenario.retries ?? 1,
+            same_account_retry_delay_ms: 0,
+          },
+        },
+      },
+    )
+    const out = await handleCodexProtocol(args)
+    assert.equal(out.status, scenario.status)
+    assert.equal(calls.length, scenario.calls)
+    assert.equal(logBag.attempt_count, scenario.calls)
+    for (const call of calls) assert.deepEqual(call, calls[0])
+    assert.notEqual(logBag.codex_failed_over, true)
+  })
+}
+
+for (const [name, retryAfter, expectedWait, headerName = 'retry-after'] of [
+  ['seconds', '2', 2000],
+  ['date', new Date(1_700_000_002_000).toUTCString(), 2000],
+  ['too long', '11', null],
+  ['overflow', '9'.repeat(309), null],
+  ['header casing', '2', 2000, 'Retry-After'],
+  ['invalid', 'invalid', 500],
+]) {
+  test(`Codex respects Retry-After ${name} without unbounded waiting`, async (t) => {
+    t.mock.timers.enable({ apis: ['Date', 'setTimeout'], now: 1_700_000_000_000 })
+    const root = fs.mkdtempSync(path.join(os.tmpdir(), 'kin-codex-retry-after-'))
+    t.after(() => fs.rmSync(root, { recursive: true, force: true }))
+    writeGptVm(root, 'vm-gpt-a')
+    if (expectedWait == null) writeGptVm(root, 'vm-gpt-b')
+    let calls = 0
+    const headers = {}
+    const args = codexArgs(
+      root,
+      {
+        ensureCodexKernel: async () => ({ ok: true }),
+        streamCodexKernel: async () => {
+          calls += 1
+          return {
+            ok: false,
+            status: 503,
+            committed: false,
+            headers: { [headerName]: retryAfter },
+            body: { error: { code: 'server_error' } },
+          }
+        },
+      },
+      {
+        routing: {
+          failover: {
+            max_total_attempts: 2,
+            max_account_switches: 1,
+            max_same_account_retries: 1,
+            same_account_retry_delay_ms: 500,
+          },
+        },
+      },
+    )
+    args.res.setHeader = (name, value) => {
+      headers[name] = value
+    }
+    const pending = handleCodexProtocol(args)
+    await new Promise(setImmediate)
+    assert.equal(calls, 1)
+    if (expectedWait != null) {
+      t.mock.timers.tick(expectedWait - 1)
+      await new Promise(setImmediate)
+      assert.equal(calls, 1)
+      t.mock.timers.tick(1)
+    } else {
+      t.mock.timers.tick(10_000)
+    }
+    const out = await pending
+    assert.equal(out.status, 503)
+    assert.equal(calls, expectedWait == null ? 1 : 2)
+    assert.equal(headers['retry-after'], retryAfter)
+  })
+}
+
+for (const [total, retries, expectedCalls] of [
+  [1, 1, 1],
+  [2, 0, 1],
+  [2, 1, 2],
+]) {
+  test(`Codex reasoning fallback shares attempt budgets ${total}/${retries}`, async (t) => {
+    const root = fs.mkdtempSync(path.join(os.tmpdir(), 'kin-codex-fallback-budget-'))
+    t.after(() => fs.rmSync(root, { recursive: true, force: true }))
+    writeGptVm(root, 'vm-gpt-a')
+    const calls = []
+    const args = codexArgs(
+      root,
+      {
+        ensureCodexKernel: async () => ({ ok: true }),
+        streamCodexKernel: async (call) => {
+          calls.push(structuredClone(call.body))
+          return {
+            ok: false,
+            status: calls.length === 1 ? 500 : 502,
+            committed: false,
+            body: { error: { code: calls.length === 1 ? 'server_error' : 'upstream_transport' } },
+          }
+        },
+      },
+      {
+        headers: { 'x-openai-internal-codex-responses-lite': 'true' },
+        body: {
+          model: 'gpt-6-astra',
+          stream: false,
+          reasoning: { context: 'all_turns', effort: 'high' },
+          input: [
+            { type: 'reasoning', encrypted_content: 'a'.repeat(100000) },
+            { type: 'reasoning', encrypted_content: 'b'.repeat(40000) },
+            { role: 'user', content: 'hi' },
+          ],
+        },
+        routing: {
+          failover: {
+            max_total_attempts: total,
+            max_same_account_retries: retries,
+            max_account_switches: 0,
+            same_account_retry_delay_ms: 0,
+          },
+        },
+      },
+    )
+    await handleCodexProtocol(args)
+    assert.equal(calls.length, expectedCalls)
+    assert.equal(args.logBag.attempt_count, expectedCalls)
+    assert.equal(args.logBag.reasoning_history_retried, expectedCalls === 2 ? true : undefined)
+    for (const call of calls) {
+      assert.equal(call.model, 'gpt-6-astra')
+      assert.deepEqual(call.reasoning, { context: 'all_turns', effort: 'high' })
+    }
+  })
+}
+
+test('Codex cancels retry backoff without another upstream call', async (t) => {
+  t.mock.timers.enable({ apis: ['Date', 'setTimeout'], now: 1_700_000_000_000 })
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'kin-codex-retry-abort-'))
+  t.after(() => fs.rmSync(root, { recursive: true, force: true }))
+  writeGptVm(root, 'vm-gpt-a')
+  let calls = 0
+  const args = codexArgs(
+    root,
+    {
+      ensureCodexKernel: async () => ({ ok: true }),
+      streamCodexKernel: async () => {
+        calls += 1
+        return { ok: false, status: 503, committed: false, body: { error: { code: 'server_error' } } }
+      },
+    },
+    {
+      routing: {
+        failover: {
+          max_total_attempts: 2,
+          max_account_switches: 0,
+          max_same_account_retries: 1,
+          same_account_retry_delay_ms: 500,
+        },
+      },
+    },
+  )
+  args.req = Object.assign(new EventEmitter(), args.req)
+  const pending = handleCodexProtocol(args)
+  await new Promise(setImmediate)
+  args.req.emit('aborted')
+  await new Promise(setImmediate)
+  t.mock.timers.tick(500)
+  await pending
+  assert.equal(calls, 1)
+  assert.equal(args.logBag.attempt_count, 1)
+  assert.equal(args.logBag.final_state, 'cancelled')
+})
+
 test('same-account retry never replays after the first SSE event', async () => {
   const rt = await import('../../src/lib/pool/openai-account-runtime.mjs')
   rt.resetOpenAIAccountRuntime()
