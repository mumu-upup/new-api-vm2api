-export async function runCodexKernelHop({ hop, args = {}, onEvent, onReasoningFallback } = {}) {
+function codexRetryAfter(result) {
+  const entry = Object.entries(result?.headers || {}).find(([name]) => name.toLowerCase() === 'retry-after')
+  const value = Array.isArray(entry?.[1]) ? entry[1][0] : entry?.[1]
+  return value == null ? null : String(value).trim()
+}
+
+// Respect upstream backoff without tying up a seat for an unbounded wait.
+async function waitForCodexRetry(result, delayMs, signal) {
+  if (signal?.aborted) return false
+  const retryAfter = codexRetryAfter(result)
+  if (retryAfter != null && String(retryAfter).trim() !== '') {
+    const seconds = Number(retryAfter)
+    if (!Number.isNaN(seconds) && seconds >= 0) delayMs = Math.max(delayMs, seconds * 1000)
+    else {
+      const retryAt = Date.parse(retryAfter)
+      if (Number.isFinite(retryAt)) delayMs = Math.max(delayMs, retryAt - Date.now())
+    }
+  }
+  if (delayMs > 10_000) return false
+  if (delayMs > 0) {
+    await new Promise((resolve) => {
+      const finish = () => {
+        clearTimeout(timer)
+        signal?.removeEventListener('abort', finish)
+        resolve()
+      }
+      const timer = setTimeout(finish, delayMs)
+      signal?.addEventListener('abort', finish, { once: true })
+      if (signal?.aborted) finish()
+    })
+  }
+  return !signal?.aborted
+}
+
+export async function runCodexKernelHop({ hop, args = {}, onEvent, onReasoningFallback, maxRetries = 1 } = {}) {
   let emitted = false
   const wrapped = async (line) => {
     emitted = true
     if (onEvent) await onEvent(line)
   }
   let result = await hop({ ...args, onEvent: wrapped })
-  if (!result?.ok && !emitted && isRetryableCodexTransport(result)) {
+  if (
+    maxRetries > 0 &&
+    !result?.ok &&
+    !emitted &&
+    isRetryableCodexTransport(result) &&
+    (await waitForCodexRetry(result, 0, args.signal)) &&
+    !args.signal?.aborted
+  ) {
     result = { ...(await hop({ ...args, onEvent: wrapped })), transport_retried: true }
   }
-  const fallback = !emitted && !result?.transport_retried ? reasoningHistoryFallback(args, result) : null
-  if (fallback) {
+  const fallback =
+    maxRetries > 0 && !emitted && !result?.transport_retried ? reasoningHistoryFallback(args, result) : null
+  if (fallback && (await waitForCodexRetry(result, 0, args.signal))) {
     if (onReasoningFallback)
       await onReasoningFallback({ originalResult: result, body: fallback.args.body, ...fallback.info })
     if (args.signal?.aborted) return result
@@ -739,9 +783,15 @@ export async function handleCodexProtocol({
         if (captureOutbound) logBag.outbound_body = outboundBody
         logBag.outbound_headers = redactHeaders(outboundHeaders)
         let hopEmitted = false
-        const runHop = () =>
-          runCodexKernelHop({
+        let sameAccountRetries = 0
+        const runHop = async () => {
+          const result = await runCodexKernelHop({
             hop,
+            maxRetries: Math.min(
+              1,
+              failoverBudget.maxSameAccountRetries - sameAccountRetries,
+              failoverBudget.maxAttempts - attempts,
+            ),
             args: {
               exec: execFor(projectRoot, vm),
               signal: gone.signal,
@@ -792,11 +842,21 @@ export async function handleCodexProtocol({
               if (named) res.write(named)
             },
           })
+          if (result?.transport_retried || result?.reasoning_history_retried) {
+            sameAccountRetries += 1
+            attempts += 1
+            hops += 1
+            logBag.attempt_count = hops
+          }
+          if (result?.transport_retried) logBag.transport_retried = true
+          if (result?.reasoning_history_retried) logBag.reasoning_history_retried = true
+          if (sameAccountRetries) logBag.codex_same_account_retried = sameAccountRetries
+          return result
+        }
         let result = await runHop()
         // A transient seat-local failure gets the same account up to N retries
         // before the request spends a switch. 401/403/429 are never retried here:
         // they are credential/account state and must move to another seat.
-        let sameAccountRetries = result?.transport_retried || result?.reasoning_history_retried ? 1 : 0
         while (
           sameAccountRetries < failoverBudget.maxSameAccountRetries &&
           attempts < failoverBudget.maxAttempts &&
@@ -806,15 +866,18 @@ export async function handleCodexProtocol({
             signal: gone.signal,
           })
         ) {
+          if (!(await waitForCodexRetry(result, sameRetryDelayMs, gone.signal)) || gone.signal.aborted) break
           sameAccountRetries += 1
           attempts += 1
           hops += 1
           logBag.attempt_count = hops
           logBag.codex_same_account_retried = sameAccountRetries
-          await new Promise((resolve) => setTimeout(resolve, sameRetryDelayMs))
-          hopEmitted = false
           result = await runHop()
         }
+        if (gone.signal.aborted) {
+          logBag.final_state = 'cancelled'
+          return
+        }
         // The log and total duration share ingress time; pool scoring keeps hop TTFT.
         logBag.first_token_ms = Number.isFinite(result?.firstTokenAt)
           ? Math.max(0, result.firstTokenAt - requestStartedAt)
@@ -826,11 +889,6 @@ export async function handleCodexProtocol({
           result.body = { error: conversionError }
         }
         ingestCodexHop(projectRoot, vm.id, result, Date.now(), normalizeCodexRouting(routing.codex).quota)
-        if (result?.transport_retried) logBag.transport_retried = true
-        if (result?.reasoning_history_retried) {
-          logBag.attempt_count += 1
-          logBag.reasoning_history_retried = true
-        }
         last = result
         const hopUsage = result.usage || result.body?.usage || result.body?.response?.usage || null
         const usage = preferUsage(hopUsage, streamedUsage)
@@ -862,7 +920,7 @@ export async function handleCodexProtocol({
           reportOpenAIAttempt(vm.id, 'succeeded', result.ttftMs ?? null)
           logBag.final_state = result?.ok ? result.terminalState || 'verified' : 'verified'
           logBag.upstream_model = converted.body.model
-          if (hops > 1) logBag.codex_failed_over = true
+          if (switches > 0) logBag.codex_failed_over = true
           if (!stream) {
             let body
             try {
@@ -895,10 +953,19 @@ export async function handleCodexProtocol({
           return res.end()
         }
         if (isCodexFailoverError(result)) {
+          if (switches >= failoverBudget.maxSwitches || attempts >= failoverBudget.maxAttempts) break
+          // A provider backoff also applies when retrying on another slot.
+          if (Number(result.status) >= 500) {
+            const retryReady = await waitForCodexRetry(result, 0, gone.signal)
+            if (gone.signal.aborted) {
+              logBag.final_state = 'cancelled'
+              return
+            }
+            if (!retryReady) break
+          }
           pickOpts.excluded.add(vm.id)
           leaveSticky()
           switches += 1
-          if (switches > failoverBudget.maxSwitches || attempts >= failoverBudget.maxAttempts) break
           continue
         }
         break
@@ -917,6 +984,8 @@ export async function handleCodexProtocol({
   stats.errors++
   logBag.error_code = last?.body?.error?.code || 'codex_upstream'
   logBag.upstream_status = last?.status || 0
+  const retryAfter = codexRetryAfter(last)
+  if (retryAfter) res.setHeader?.('retry-after', retryAfter)
   return json(res, last?.status || 502, last?.body || { error: { type: 'api_error', code: 'codex_upstream' } })
 }
 
diff --git a/test/unit/handle-codex.test.mjs b/test/unit/handle-codex.test.mjs
